# Copy to .env and fill in. Node does not load .env automatically:
#   node --env-file=.env dist/server.js
# Docker: docker run --env-file .env ...

# Port the HTTP server listens on. Default: 8787
# PORT=8787

# Shared secret for the API and web UI. Generate with: openssl rand -hex 32
# If empty, authentication is disabled. Use only for local testing.
AUTH_TOKEN=

# Your Send-to-Kindle address (ends in @kindle.com).
# Find it in Amazon: Manage Your Content and Devices > Preferences > Personal Document Settings.
KINDLE_EMAIL=you@kindle.com

# Sender address for emails. Default: SMTP_USER.
# Must be on Amazon's Approved Personal Document E-mail List.
# FROM_EMAIL=you@gmail.com

# SMTP server for sending to Kindle. If SMTP_HOST is empty, the service runs in
# download-only mode (no email).
# Example for Gmail: smtp.gmail.com (requires a Google App Password).
SMTP_HOST=
# Default: 587
# SMTP_PORT=587
# Use implicit TLS. Default: true when SMTP_PORT is 465, otherwise false.
# SMTP_SECURE=false
SMTP_USER=
# SMTP password. For Gmail, use an App Password (requires 2-Step Verification).
SMTP_PASS=

# Maximum size of an uploaded or fetched input, in bytes. Default: 26214400 (25 MB)
# MAX_BYTES=26214400

# Timeout for fetching a web page, in milliseconds. Default: 20000
# FETCH_TIMEOUT_MS=20000

# Leave false. Setting true disables the protection against fetching internal
# network addresses. Default: false
# ALLOW_PRIVATE_HOSTS=false
